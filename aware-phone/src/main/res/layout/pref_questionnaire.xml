<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="20dp"
    android:paddingHorizontal="15dp">

    <TextView
        android:id="@+id/questionnaire_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Initiate answering if they are not prompted"
        android:textAppearance="@style/TextAppearance.AppCompat.Body1" />

    <Button
        android:id="@+id/btn_day_questionnaire"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_below="@android:id/list"
        android:background="@color/accent"
        android:text="@string/day_questionnaire"
        android:textColor="@android:color/white"
        android:paddingHorizontal="50dp"
        android:layout_marginVertical="10dp" />
    <Button
        android:id="@+id/btn_evening_questionnaire"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_below="@android:id/list"
        android:background="@color/accent"
        android:text="@string/evening_questionnaire"
        android:textColor="@android:color/white"
        android:paddingHorizontal="50dp"
        android:layout_marginVertical="10dp" />
</LinearLayout>